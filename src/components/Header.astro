---
const RESUME_URL =
  "https://docs.google.com/viewer?url=https://github.com/evinaik/resume/raw/master/resume.pdf";
const { pathname } = Astro.url;
---

<header>
  <h1>
    <a href="/" aria-label="Ekansh Vinaik">
      <span class="typewriter" data-text="Ekansh Vinaik">Ekansh Vinaik</span>
    </a>
  </h1>
  <nav>
    <ul>
      <li>
        <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Home</a>
      </li>
      <li><a href={RESUME_URL}>Resume</a></li>
    </ul>
  </nav>
</header>

<style>
  header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
  }

  h1 {
    color: var(--heading);
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0;
  }

  h1 a {
    color: inherit;
    text-decoration: none;
  }

  .typewriter::after {
    content: "|";
    color: var(--purple);
    font-weight: 300;
  }

  .typewriter.done::after {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav li {
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  nav a {
    color: inherit;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--purple);
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter::after {
      display: none;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>(".typewriter");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduced) {
    const text = el.dataset.text ?? el.textContent ?? "";
    el.textContent = "";
    let i = 0;
    const tick = () => {
      el.textContent = text.slice(0, ++i);
      if (i < text.length) {
        setTimeout(tick, 75);
      } else {
        el.classList.add("done");
      }
    };
    setTimeout(tick, 250);
  } else if (el) {
    el.classList.add("done");
  }
</script>
