---
const { pathname } = Astro.url;
---

<header>
  <h1>
    <a href="/" aria-label="Ekansh Vinaik">
      <span class="typewriter" data-text="Ekansh Vinaik">Ekansh Vinaik</span>
    </a>
  </h1>
  <nav>
    <ul>
      <li>
        <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Home</a>
      </li>
      <li>
        <a href="/stuff" aria-current={pathname === "/stuff" || pathname === "/stuff/" ? "page" : undefined}>Stuff</a>
      </li>
      <li>
        <button type="button" class="theme-toggle" title="Switch theme">
          <span class="visually-hidden">Switch theme</span>
          <svg
            class="icon moon"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg
            class="icon sun"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  h1 {
    color: var(--heading);
    font-size: 1.5em;
    font-weight: 500;
    text-align: center;
  }

  h1 a {
    text-decoration: none;
  }

  h1 a,
  h1 a:visited {
    color: inherit;
  }

  .typewriter::after {
    content: "|";
    color: var(--purple);
    font-weight: 300;
  }

  .typewriter.done::after {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  nav {
    text-align: center;
  }

  nav ul {
    align-items: center;
    color: var(--text);
    display: flex;
    font-size: 1.2em;
    list-style: none;
    justify-content: center;
    padding: 0;
  }

  nav li {
    text-transform: uppercase;
    margin: 0 1em;
  }

  nav a {
    text-decoration: none;
  }

  nav a,
  nav a:visited {
    color: inherit;
  }

  nav a:hover {
    color: var(--purple);
  }

  nav a[aria-current="page"] {
    color: var(--purple);
  }

  .theme-toggle {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: flex;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--purple);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Show the icon for the theme the button switches *to*. */
  .sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .moon {
      display: none;
    }
    :root:not([data-theme="light"]) .sun {
      display: block;
    }
  }

  :root[data-theme="dark"] .moon {
    display: none;
  }
  :root[data-theme="dark"] .sun {
    display: block;
  }

  :root[data-theme="light"] .moon {
    display: block;
  }
  :root[data-theme="light"] .sun {
    display: none;
  }

  @media (max-width: 560px) {
    header {
      justify-content: center;
    }

    h1 {
      flex-basis: 100%;
      margin-bottom: 0;
    }

    nav ul {
      flex-wrap: wrap;
      margin-top: 0;
    }

    nav li {
      margin: 0 0.6em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter::after {
      display: none;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>(".typewriter");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduced) {
    const text = el.dataset.text ?? el.textContent ?? "";
    el.textContent = "";
    let i = 0;
    const tick = () => {
      el.textContent = text.slice(0, ++i);
      if (i < text.length) {
        setTimeout(tick, 75);
      } else {
        el.classList.add("done");
      }
    };
    setTimeout(tick, 250);
  } else if (el) {
    el.classList.add("done");
  }

  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const current = () =>
    root.dataset.theme ?? (systemDark.matches ? "dark" : "light");

  const label = () => {
    if (!button) return;
    const next = current() === "dark" ? "light" : "dark";
    const text = `Switch to ${next} theme`;
    button.title = text;
    const sr = button.querySelector(".visually-hidden");
    if (sr) sr.textContent = text;
  };

  button?.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
    label();
  });

  // Keep the label right if the system flips while no choice is stored.
  systemDark.addEventListener("change", label);
  label();
</script>
