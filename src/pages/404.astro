---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found">
  <h2>Page not found</h2>
  <p>
    Sorry <span role="img" aria-label="Pensive emoji">😔</span> we couldn't find
    what you were looking for.
  </p>
  <p><a href="/">Go home</a>.</p>
</Layout>

<style>
  h2 {
    color: var(--heading);
    font-size: 1.25rem;
    font-weight: 500;
  }
</style>
